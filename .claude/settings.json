{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(~/mtah2027-data/**)",
      "Read(//**/mtah2027-data/**)",
      "Read(//**/BAR-ATH_tactical*)",
      "Read(//**/BAR-ATH_broadcast*)",
      "Read(//**/*.mp4)",
      "Read(/data/tactical/**)",
      "Read(/data/broadcast/**)",
      "Read(/evaluation/results/*.csv)",
      "Read(/evaluation/reports/**)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff --stat *)",
      "Bash(git diff --name-only *)",
      "Bash(git diff --name-status *)",
      "Bash(git diff --cached --stat *)",
      "Bash(git diff --cached --name-only *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git fetch *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(gh auth status)",
      "Bash(gh api user --jq .login)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(python evaluation/run_evaluation.py *)",
      "Bash(python evaluation/validate_submission.py *)",
      "Bash(python3 evaluation/run_evaluation.py *)",
      "Bash(python3 evaluation/validate_submission.py *)",
      "Bash(python .claude/skills/subir/outputs_notebooks.py *)",
      "Bash(python3 .claude/skills/subir/outputs_notebooks.py *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff --stat *)",
      "PowerShell(git diff --name-only *)",
      "PowerShell(git diff --name-status *)",
      "PowerShell(git diff --cached --stat *)",
      "PowerShell(git diff --cached --name-only *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -vv)",
      "PowerShell(git fetch *)",
      "PowerShell(git remote -v)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git rev-list *)",
      "PowerShell(git config user.name)",
      "PowerShell(git config user.email)",
      "PowerShell(gh auth status)",
      "PowerShell(gh api user --jq .login)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr status *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(python evaluation/run_evaluation.py *)",
      "PowerShell(python evaluation/validate_submission.py *)",
      "PowerShell(python .claude/skills/subir/outputs_notebooks.py *)"
    ]
  }
}
